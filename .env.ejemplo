# Copia este archivo como .env y completa los valores. NUNCA subas .env a git.

# Contraseña del usuario de PostgreSQL (inventa una larga).
DB_USUARIO=postgres
DB_PASSWORD=

# Clave para firmar las sesiones (JWT). Genera una con:
#   openssl rand -base64 48
JWT_SECRET=

# Administrador inicial (solo se crea si no existe ningun Administrador).
# Minimo 10 caracteres. Cambiala desde Configuracion despues del primer ingreso.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=
ADMIN_CORREO=

# false = el mapa solo muestra la ubicacion que reporta el conductor.
# true  = modo demostracion (posicion y paradas simuladas).
SIMULACION_HABILITADA=false

# Puerto donde queda la app sin HTTPS (http://IP-del-servidor:8080).
PUERTO_APP=8080

# Solo si usas HTTPS con dominio (docker compose --profile https up -d).
DOMINIO=
